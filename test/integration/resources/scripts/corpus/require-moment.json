{
  "id": "require-moment",
  "covers": [
    "sandbox-api §4 moment"
  ],
  "source": {
    "kind": "hand-written",
    "licence": "Xenon project (same licence as this repository)"
  },
  "phase": "prerequest",
  "script": "const moment = require('moment'); const d = moment.utc('2024-01-31T10:00:00Z'); console.log(d.add(1, 'month').format('YYYY-MM-DD'), moment.utc('2024-03-01').diff(moment.utc('2024-02-01'), 'days'), moment.utc('2024-02-29').isValid(), moment('2024-13-01', 'YYYY-MM-DD', true).isValid());",
  "request": {
    "url": "https://api.example.com/v1/users?page=2&limit=10",
    "method": "POST",
    "header": [
      {
        "key": "Content-Type",
        "value": "application/json"
      },
      {
        "key": "X-Trace",
        "value": "abc"
      }
    ],
    "body": {
      "mode": "raw",
      "raw": "{\"name\":\"Ada\",\"tags\":[\"a\",\"b\"]}"
    }
  },
  "environment": {
    "name": "dev",
    "values": [
      {
        "key": "base_url",
        "value": "https://api.example.com"
      },
      {
        "key": "user",
        "value": "ada"
      },
      {
        "key": "shared",
        "value": "from-env"
      }
    ]
  },
  "collectionVariables": [
    {
      "key": "version",
      "value": "v1"
    },
    {
      "key": "shared",
      "value": "from-collection"
    },
    {
      "key": "coll_only",
      "value": "c"
    }
  ],
  "globals": [
    {
      "key": "tenant",
      "value": "acme"
    },
    {
      "key": "shared",
      "value": "from-globals"
    },
    {
      "key": "glob_only",
      "value": "g"
    }
  ],
  "variables": [
    {
      "key": "local_only",
      "value": "l"
    }
  ],
  "cookies": [
    {
      "name": "session",
      "value": "s1",
      "domain": "api.example.com",
      "path": "/"
    },
    {
      "name": "theme",
      "value": "dark",
      "domain": "api.example.com",
      "path": "/"
    }
  ]
