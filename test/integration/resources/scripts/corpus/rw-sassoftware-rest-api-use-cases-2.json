    "licence": "Apache-2.0",
    "item": "7. Remove Instance from a Tag"
  },
  "phase": "test",
  "script": "if(pm.response.code === 200) {\n    console.log(\"7. Instance untagged successfully\");\n\n    // Need to update the tag's etag since the tag was updated\n    const update_etag_request = {\n        url: `${pm.environment.get('sasserver')}/catalog/tags/${pm.environment.get(\"tag_id\")}`,\n        method: 'GET',\n        header: {\n            'Accept': 'application/vnd.sas.metadata.tag+json',\n            'Authorization': `Bearer ${pm.environment.get('access_token')}`\n        },\n    }\n    pm.sendRequest(update_etag_request, (error, response) => {\n        pm.environment.set(\"tag_etag\", response.headers.get(\"ETag\"));\n    });\n\n    // Set tag_last_modified to be used in the PATCH tag request\n    postman.setEnvironmentVariable(\"tag_last_modified\", postman.getResponseHeader(\"Last-Modified\"));\n} else {\n    console.log(\"7. Untag instance failed with status: \" + pm.response.status);\n}",
  "request": {
    "url": "{{sasserver}}/catalog/tags?onConflict=update",
    "method": "PATCH",
    "header": [
      {
        "key": "Content-Type",
        "value": "application/vnd.sas.metadata.patch.archive+json"
      },
      {
        "key": "If-Unmodified-Since",
        "value": "{{tag_last_modified}}"
      }
    ],
    "body": {
      "mode": "raw",
      "raw": "{\r\n    \"tags\": {\r\n        \"{{tag_id}}\": [\r\n            {\r\n                \"op\": \"remove\",\r\n                \"path\": \"/members/resources\",\r\n                \"value\": \"{{sample_instance2_id}}\"\r\n            }\r\n        ]\r\n    }\r\n}"
    }
  },
  "environment": {
