    "method": "POST",
    "header": [
      {
        "key": "Authorization",
        "value": "redacted-value"
      },
      {
        "key": "Accept",
        "value": "application/json"
      },
      {
        "key": "Content-Type",
        "value": "application/x-www-form-urlencoded;charset=UTF-8"
      }
    ],
    "body": {
      "mode": "urlencoded",
      "urlencoded": [
        {
          "key": "grant_type",
          "value": "password"
        },
        {
          "key": "username",
          "value": "{{RINGCENTRAL_USERNAME}}"
        },
        {
          "key": "password",
          "value": "redacted-value"
        },
        {
          "key": "extension",
          "value": "{{RINGCENTRAL_EXTENSION}}"
        }
      ]
    }
  },
