    "item": "Fetch access_token"
  },
  "phase": "test",
  "script": "var jsonData = JSON.parse(responseBody);\ntests[\"Contains an access_token\"] = jsonData.hasOwnProperty('access_token');\n\ntests[\"Status code is 200\"] = responseCode.code === 200;\n\npostman.setEnvironmentVariable(\"my_access_token\", jsonData.access_token);",
  "request": {
