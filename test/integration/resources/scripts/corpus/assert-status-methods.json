  "phase": "test",
  "script": "pm.test('status code', () => pm.response.to.have.status(200));\npm.test('status code wrong', () => pm.response.to.have.status(201));\npm.test('status reason', () => pm.response.to.have.status('OK'));\npm.test('status reason wrong', () => pm.response.to.have.status('Created'));\npm.test('statusCode', () => pm.response.to.have.statusCode(200));\npm.test('statusCode wrong', () => pm.response.to.have.statusCode(404));\npm.test('statusCodeClass', () => pm.response.to.have.statusCodeClass(2));\npm.test('statusCodeClass wrong', () => pm.response.to.have.statusCodeClass(4));\npm.test('statusReason', () => pm.response.to.have.statusReason('OK'));\npm.test('statusReason wrong', () => pm.response.to.have.statusReason('Not Found'));\npm.test('not status', () => pm.response.to.not.have.status(200));",
