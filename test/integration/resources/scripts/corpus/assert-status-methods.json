{
  "id": "assert-status-methods",
  "covers": [
    "sandbox-api §2 status",
    "sandbox-api §2 statusCode",
    "sandbox-api §2 statusCodeClass",
    "sandbox-api §2 statusReason"
  ],
  "source": {
    "kind": "hand-written",
