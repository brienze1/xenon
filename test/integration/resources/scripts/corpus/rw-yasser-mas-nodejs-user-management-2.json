{
  "id": "rw-yasser-mas-nodejs-user-management-2",
  "covers": [
    "real-world",
    "real-world oauth-token-chain",
    "real-world lodash"
  ],
  "source": {
    "kind": "public-collection",
    "repository": "https://github.com/yasser-mas/nodejs-user-management",
    "path": "node-user-management.postman_collection.json",
    "url": "https://github.com/yasser-mas/nodejs-user-management/blob/20c832e5c5bae6ddabc631419abf4647cd32f4dd/node-user-management.postman_collection.json",
    "licence": "MIT",
    "item": "Refresh Token"
  },
  "phase": "test",
  "script": "let jsonData = pm.response.json();\n\n\n// console.log(_.get(jsonData,'object.tokenObj.token'));\n\npm.globals.set('user_token', _.get(jsonData,'object.accessToken'));\npm.globals.set('user_refresh_token', _.get(jsonData,'object.refreshToken'));",
  "request": {
    "url": "{{url}}/auth/refresh-token",
    "method": "POST",
    "header": [
      {
        "key": "Content-Type",
        "value": "application/json"
      },
      {
        "key": "Token",
        "value": "redacted-value"
      }
    ],
    "body": {
      "mode": "raw",
      "raw": "{\n  \"token\":\"{{user_refresh_token}}\"\n}"
    }
  },
  "environment": {
    "name": "real-world",
    "values": []
  },
  "collectionVariables": [
    {
      "key": "url",
      "value": "localhost:8082"
    }
  ],
  "globals": [],
  "variables": [],
  "cookies": [],
  "response": {
    "code": 200,
    "status": "OK",
    "header": [
      {
        "key": "Content-Type",
        "value": "application/json"
      }
    ],
    "body": "{\"id\":1,\"name\":\"example\",\"status\":\"active\",\"data\":[{\"id\":1,\"value\":\"a\"},{\"id\":2,\"value\":\"b\"}],\"token\":\"test-token\",\"access_token\":\"test-access-token\",\"success\":true,\"message\":\"ok\",\"total\":2}",
    "responseTime": 120
  }
}
