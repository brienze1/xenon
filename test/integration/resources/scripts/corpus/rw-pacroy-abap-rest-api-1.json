  "script": "if (tests[\"Status code is 200\"] = responseCode.code === 200) {\n    var token = postman.getResponseHeader(\"x-csrf-token\");\n    tests[\"x-csrf-token=\" + token] = true;\n    pm.environment.set(\"x-csrf-token\", token);\n}",
