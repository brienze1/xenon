  "phase": "prerequest",
  "script": "console.log(new Intl.NumberFormat('en-US', {style: 'currency', currency: 'USD'}).format(1234.5));\nconsole.log(new Intl.DateTimeFormat('en-US', {timeZone: 'UTC', dateStyle: 'medium'}).format(new Date(Date.UTC(2024, 1, 29))));\nconsole.log((1234567.891).toLocaleString('en-US'), new Date(Date.UTC(2024, 0, 5)).toLocaleDateString('en-US', {timeZone: 'UTC'}));\nconsole.log(new Intl.PluralRules('en-US').select(1), new Intl.PluralRules('en-US').select(2));",
