{
  "id": "pm-request-body-graphql",
  "covers": [
    "sandbox-api §1 pm.request.body"
  ],
  "source": {
    "kind": "hand-written",
    "licence": "Xenon project (same licence as this repository)"
  },
  "phase": "prerequest",
  "script": "const b = pm.request.body;\nconsole.log(b.mode, b.graphql.query, JSON.stringify(b.graphql.variables));",
  "request": {
    "url": "https://api.example.com/graphql",
    "method": "POST",
    "header": [],
    "body": {
      "mode": "graphql",
      "graphql": {
        "query": "query { me { id } }",
        "variables": "{\"a\":1}"
      }
    }
  },
  "environment": {
    "name": "dev",
    "values": [
      {
        "key": "base_url",
        "value": "https://api.example.com"
      },
      {
        "key": "user",
        "value": "ada"
      },
      {
        "key": "shared",
        "value": "from-env"
      }
    ]
  },
  "collectionVariables": [
    {
      "key": "version",
      "value": "v1"
    },
    {
      "key": "shared",
      "value": "from-collection"
    },
    {
      "key": "coll_only",
      "value": "c"
    }
  ],
  "globals": [
    {
      "key": "tenant",
      "value": "acme"
    },
    {
      "key": "shared",
      "value": "from-globals"
    },
    {
      "key": "glob_only",
      "value": "g"
    }
  ],
  "variables": [
    {
      "key": "local_only",
      "value": "l"
    }
  ],
  "cookies": [
    {
      "name": "session",
      "value": "s1",
      "domain": "api.example.com",
      "path": "/"
    },
    {
      "name": "theme",
      "value": "dark",
      "domain": "api.example.com",
      "path": "/"
    }
  ]
}
