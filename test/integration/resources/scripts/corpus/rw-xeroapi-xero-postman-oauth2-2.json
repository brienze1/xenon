{
  "id": "rw-xeroapi-xero-postman-oauth2-2",
  "covers": [
    "real-world",
    "real-world oauth-token-chain",
    "real-world legacy"
  ],
  "source": {
    "kind": "public-collection",
    "repository": "https://github.com/XeroAPI/xero-postman-oauth2",
    "path": "Xero OAuth 2.0.postman_collection.json",
    "url": "https://github.com/XeroAPI/xero-postman-oauth2/blob/757908267477ce1a6493b2edee67f64bcdfd127b/Xero OAuth 2.0.postman_collection.json",
    "licence": "MIT",
    "item": "Refresh token"
  },
  "phase": "test",
  "script": "var data = JSON.parse(responseBody);\nif (data.access_token) {postman.setEnvironmentVariable(\"access_token\", data.access_token)};\nif (data.refresh_token) {postman.setEnvironmentVariable(\"refresh_token\", data.refresh_token)};\n\ntests[\"Access Token: \" + pm.environment.get(\"access_token\") + \" Refresh Token: \" + pm.environment.get(\"refresh_token\")] = true;",
  "request": {
    "url": "https://identity.xero.com/connect/token",
    "method": "POST",
    "header": [
      {
        "key": "grant_type",
        "value": "refresh_token"
      },
      {
        "key": "Content-Type",
        "value": "application/json"
      }
    ],
    "body": {
      "mode": "formdata",
      "formdata": [
        {
          "key": "grant_type",
          "value": "refresh_token"
        },
        {
          "key": "refresh_token",
          "value": "redacted-value"
        },
        {
          "key": "client_id",
          "value": "{{client_id}}"
        },
        {
          "key": "client_secret",
          "value": "redacted-value"
        }
      ]
    }
  },
  "environment": {
    "name": "real-world",
    "values": []
  },
  "collectionVariables": [],
  "globals": [],
  "variables": [],
  "cookies": [],
  "response": {
    "code": 200,
    "status": "OK",
    "header": [
      {
        "key": "Content-Type",
        "value": "application/json"
      }
    ],
    "body": "{\"id\":1,\"name\":\"example\",\"status\":\"active\",\"data\":[{\"id\":1,\"value\":\"a\"},{\"id\":2,\"value\":\"b\"}],\"token\":\"test-token\",\"access_token\":\"test-access-token\",\"success\":true,\"message\":\"ok\",\"total\":2}",
    "responseTime": 120
  }
}
