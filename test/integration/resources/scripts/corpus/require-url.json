  "script": "const url = require('url'); const p = url.parse('https://u@x.example:81/p?q=1#h', true); console.log(p.host, p.pathname, p.query, url.format({protocol: 'https', host: 'y.example', pathname: '/z'})); console.log(url.resolve('https://a.example/b/c', '../d'));",
