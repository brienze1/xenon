{
  "id": "pm-variables-scopes",
  "covers": [
    "sandbox-api §1 pm.variables"
  ],
  "source": {
    "kind": "hand-written",
    "licence": "Xenon project (same licence as this repository)"
  },
  "phase": "prerequest",
  "script": "console.log(pm.variables.get('shared'), pm.variables.get('coll_only'), pm.variables.get('glob_only'), pm.variables.get('local_only'), pm.variables.get('missing'));\nconsole.log(pm.variables.has('user'), pm.variables.has('nope'));\npm.variables.set('shared', 'from-local');\npm.variables.set('num', 42);\npm.variables.set('obj', {a: 1});\nconsole.log(pm.variables.get('shared'), typeof pm.variables.get('num'), pm.variables.get('obj'));\nconsole.log(pm.variables.replaceIn('{{base_url}}/{{version}}/{{tenant}}/{{shared}}/{{unknown}}'));\nconsole.log(pm.variables.toObject());",
  "request": {
    "url": "https://api.example.com/v1/users?page=2&limit=10",
    "method": "POST",
    "header": [
      {
        "key": "Content-Type",
        "value": "application/json"
      },
      {
        "key": "X-Trace",
        "value": "abc"
      }
    ],
    "body": {
      "mode": "raw",
      "raw": "{\"name\":\"Ada\",\"tags\":[\"a\",\"b\"]}"
    }
  },
  "environment": {
    "name": "dev",
    "values": [
      {
        "key": "base_url",
        "value": "https://api.example.com"
      },
      {
        "key": "user",
        "value": "ada"
      },
      {
        "key": "shared",
        "value": "from-env"
      }
    ]
  },
  "collectionVariables": [
    {
      "key": "version",
      "value": "v1"
    },
    {
      "key": "shared",
      "value": "from-collection"
    },
    {
      "key": "coll_only",
      "value": "c"
    }
  ],
  "globals": [
    {
      "key": "tenant",
      "value": "acme"
    },
    {
      "key": "shared",
      "value": "from-globals"
    },
    {
      "key": "glob_only",
      "value": "g"
    }
  ],
  "variables": [
    {
      "key": "local_only",
      "value": "l"
    }
  ],
  "cookies": [
    {
      "name": "session",
      "value": "s1",
      "domain": "api.example.com",
      "path": "/"
    },
    {
      "name": "theme",
      "value": "dark",
      "domain": "api.example.com",
      "path": "/"
    }
  ]
}
