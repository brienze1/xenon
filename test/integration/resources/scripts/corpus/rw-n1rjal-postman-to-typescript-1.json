  "phase": "test",
  "script": "pm.test(\"Getting User Profile From Token\",function(){\n    pm.response.to.have.status(200);\n});\n\npm.test(\"Body have _id\", function () {\n    pm.expect(pm.response.text()).to.include(\"_id\");\n});\n\npm.test(\"Email field is there\", function () {\n    pm.expect(pm.response.text()).to.include(\"email\");\n});\n\npm.test(\"Phone field is there\", function () {\n    pm.expect(pm.response.text()).to.include(\"phone\");\n});\n\npm.test(\"Check If admin True or False\", function () {\n    pm.expect(pm.response.text()).to.include(\"is_admin\");\n});",
  "request": {
    "url": "{{host}}/user/token-user",
    "method": "GET",
    "header": []
  },
