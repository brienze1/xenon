{
  "id": "rw-autodesk-platform-services-aps-data-conn-3",
  "covers": [
    "real-world",
    "real-world legacy"
  ],
  "source": {
    "kind": "public-collection",
    "repository": "https://github.com/autodesk-platform-services/aps-data-connector-postman.collection",
    "path": "Data Connector.postman_collection.json",
    "url": "https://github.com/autodesk-platform-services/aps-data-connector-postman.collection/blob/298202619fd3b9e8f561ec5968eabe46e46406c0/Data Connector.postman_collection.json",
    "licence": "MIT",
    "item": "01-Create One_Time Request-Account Level"
  },
  "phase": "test",
  "script": "pm.test(\"Create One_Time Request- status code is 200\", function () {\n    pm.response.to.have.status(200);\n});\n\npm.test(\"find request id\", function () {\n    var body = JSON.parse(responseBody);\n    pm.expect(body).not.eq(undefined);\n    pm.environment.set(\"request_id\", body.id);\n\n    console.log(body);\n});",
  "request": {
    "url": "{{base_domain}}/data-connector/v1/accounts/{{hub_id_b360}}/requests",
    "method": "POST",
    "header": [
      {
        "key": "Authorization",
        "value": "redacted-value"
      },
      {
        "key": "Content-Type",
        "value": "application/json"
      }
    ],
    "body": {
      "mode": "raw",
      "raw": "{\r\n    \"description\":\"Test by API - {{current_time}}\",\r\n    \"isActive\": true, \r\n    \"scheduleInterval\": \"ONE_TIME\",\r\n    \"serviceGroups\": [ \r\n        \"issues\" ,\r\n        \"dailylogs\"\r\n        //\"all\"  // if all only, fetch data of all services\r\n\r\n    ],  \r\n    \"effectiveFrom\": \"{{effective_from}}\",\r\n    \"callbackUrl\": \"{{callbackUrl}}\"\r\n}"
    }
  },
  "environment": {
    "name": "real-world",
    "values": []
  },
  "collectionVariables": [
    {
      "key": "encodedKeys",
      "value": "redacted-value"
    }
  ],
  "globals": [],
  "variables": [],
  "cookies": [],
  "response": {
    "code": 200,
    "status": "OK",
    "header": [
      {
        "key": "Content-Type",
        "value": "application/json"
      }
    ],
    "body": "{\"id\":1,\"name\":\"example\",\"status\":\"active\",\"data\":[{\"id\":1,\"value\":\"a\"},{\"id\":2,\"value\":\"b\"}],\"token\":\"test-token\",\"access_token\":\"test-access-token\",\"success\":true,\"message\":\"ok\",\"total\":2}",
    "responseTime": 120
  }
}
