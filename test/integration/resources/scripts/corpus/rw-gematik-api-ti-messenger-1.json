  "phase": "test",
  "script": "pm.test(\"succeeds\", () => {\n    pm.response.to.have.status(200);\n});\n\nconst json = pm.response.json();\nconst accessToken = json.access_token;\n\npm.test(\"has access token\", () => {\n    pm.expect(accessToken).to.not.be.oneOf([undefined, null]);\n});\n\nconst serverName = json.matrix_server_name;\n\npm.test(\"has server name\", () => {\n    pm.expect(serverName).to.not.be.oneOf([undefined, null]);\n});\n\npm.globals.set(\"matrixopenidtoken\", accessToken);\npm.globals.set(\"matrix_server_name\", serverName);",
  "request": {
    "url": "{{matrix_server}}/_matrix/client/v3/user/{{matrix_user}}/openid/request_token",
