{
  "id": "rw-hpinc-printos-box-api-samples-1",
  "covers": [
    "real-world",
    "real-world legacy"
  ],
  "source": {
    "kind": "public-collection",
    "repository": "https://github.com/HPInc/printos-box-api-samples",
    "path": "postman/PrintOS Box.postman_collection.json",
    "url": "https://github.com/HPInc/printos-box-api-samples/blob/2681ed07f270cef9160340b9fb46a48cb083be77/postman/PrintOS Box.postman_collection.json",
    "licence": "MIT",
    "item": "Box Upload File"
  },
  "phase": "test",
  "script": "var responseJSON;\ntry {\n    responseJSON = JSON.parse(responseBody);\n    tests[\"File _id not empty\"] = responseJSON._id !== \"\";\n    postman.setEnvironmentVariable(\"lastFileId\", responseJSON._id);\n}\ncatch (e) {}\n\ntests[\"Status code is 201\"] = responseCode.code === 200;",
  "request": {
    "url": "{{baseURL}}box/api/partner/file",
    "method": "POST",
    "header": [
      {
        "key": "x-hp-hmac-authentication",
        "value": "redacted-value"
      },
      {
        "key": "x-hp-hmac-date",
        "value": "{{timestamp}}"
      },
      {
        "key": "x-hp-hmac-algorithm",
        "value": "SHA256"
      },
      {
        "key": "Content-Type",
        "value": "application/json"
      }
    ],
    "body": {
      "mode": "raw",
      "raw": "{\r\n    \"url\": \"https://redacted-value\",\r\n    \"name\": \"Mountain JPEG\",\r\n    \"folderId\":\"{{lastFolderId}}\",\r\n    \"copies\": 5,\r\n    \"notes\": \"Picture from w3schools website\",\r\n    \"substrate\": \"{{substrate}}\",\r\n    \"flow\": \"{{flow}}\"\r\n}"
    }
  },
  "environment": {
    "name": "real-world",
    "values": []
  },
  "collectionVariables": [],
  "globals": [],
  "variables": [],
  "cookies": [],
  "response": {
    "code": 200,
    "status": "OK",
    "header": [
      {
        "key": "Content-Type",
        "value": "application/json"
      }
    ],
    "body": "{\"id\":1,\"name\":\"example\",\"status\":\"active\",\"data\":[{\"id\":1,\"value\":\"a\"},{\"id\":2,\"value\":\"b\"}],\"token\":\"test-token\",\"access_token\":\"test-access-token\",\"success\":true,\"message\":\"ok\",\"total\":2}",
    "responseTime": 120
  }
}
