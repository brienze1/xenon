{
  "id": "pm-request-headers-mutate",
  "covers": [
    "sandbox-api §1 pm.request.headers"
  ],
  "source": {
    "kind": "hand-written",
    "licence": "Xenon project (same licence as this repository)"
  },
  "phase": "prerequest",
  "script": "const h = pm.request.headers;\nh.add({key: 'X-Added', value: '1'});\nh.upsert({key: 'X-Trace', value: 'changed'});\nh.upsert({key: 'X-New', value: 'n'});\nh.remove('Content-Type');\nh.insert({key: 'X-First', value: 'f'}, 'X-Trace');\nh.prepend({key: 'X-Pre', value: 'p'});\nh.append({key: 'X-App', value: 'a'});\nconsole.log(h.toObject());\npm.request.addHeader({key: 'X-AddHeader', value: 'ah'});\npm.request.upsertHeader({key: 'X-AddHeader', value: 'ah2'});\npm.request.removeHeader('X-Pre');\nconsole.log(h.all().map((x) => x.key + '=' + x.value));",
  "request": {
    "url": "https://api.example.com/v1/users?page=2&limit=10",
    "method": "POST",
    "header": [
      {
        "key": "Content-Type",
        "value": "application/json"
      },
      {
        "key": "X-Trace",
        "value": "abc"
      }
    ],
    "body": {
      "mode": "raw",
      "raw": "{\"name\":\"Ada\",\"tags\":[\"a\",\"b\"]}"
    }
  },
  "environment": {
    "name": "dev",
    "values": [
      {
        "key": "base_url",
        "value": "https://api.example.com"
      },
      {
        "key": "user",
        "value": "ada"
      },
      {
        "key": "shared",
        "value": "from-env"
      }
    ]
  },
  "collectionVariables": [
    {
      "key": "version",
      "value": "v1"
    },
    {
      "key": "shared",
      "value": "from-collection"
    },
    {
      "key": "coll_only",
      "value": "c"
    }
  ],
  "globals": [
    {
      "key": "tenant",
      "value": "acme"
    },
    {
      "key": "shared",
      "value": "from-globals"
    },
    {
      "key": "glob_only",
      "value": "g"
    }
  ],
  "variables": [
    {
      "key": "local_only",
      "value": "l"
    }
