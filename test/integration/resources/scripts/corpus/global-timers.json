{
  "id": "global-timers",
  "covers": [
    "sandbox-api §3 timers"
  ],
  "source": {
    "kind": "hand-written",
    "licence": "Xenon project (same licence as this repository)"
  },
  "phase": "prerequest",
  "script": "const order = [];\nsetTimeout(() => order.push('timeout'), 5);\nsetImmediate(() => order.push('immediate'));\nconst i = setInterval(() => { order.push('interval'); clearInterval(i); }, 1);\nconst c = setTimeout(() => order.push('cleared'), 1); clearTimeout(c);\nconst ci = setImmediate(() => order.push('cleared immediate')); clearImmediate(ci);\nawait new Promise((resolve) => setTimeout(resolve, 30));\nconsole.log(order.sort());",
  "request": {
    "url": "https://api.example.com/v1/users?page=2&limit=10",
