{
  "id": "rw-luismvst-extension-3",
  "covers": [
    "real-world",
    "real-world oauth-token-chain"
  ],
  "source": {
    "kind": "public-collection",
    "repository": "https://github.com/Luismvst/extension",
    "path": "json_to_postman.json",
    "url": "https://github.com/Luismvst/extension/blob/708a61386886346a185400cd07800e7ccb140150/json_to_postman.json",
    "licence": "MIT",
    "item": "POST /auth/login"
  },
  "phase": "test",
  "script": "pm.test('Login 200', ()=> pm.response.to.have.status(200));\nconst data = pm.response.json();\npm.test('access_token present', ()=> pm.expect(data).to.have.property('access_token'));\npm.collectionVariables.set('token', data.access_token);",
  "request": {
    "url": "{{baseUrl}}/auth/login",
    "method": "POST",
    "header": [
      {
        "key": "Content-Type",
        "value": "application/json"
      }
    ],
    "body": {
      "mode": "raw",
      "raw": "{\"email\": \"user@example.com\", \"password\": \"admin123\"}"
    }
  },
  "environment": {
    "name": "real-world",
    "values": []
  },
  "collectionVariables": [
    {
      "key": "baseUrl",
      "value": "http://127.0.0.1:8080"
    },
    {
      "key": "token",
      "value": "redacted-value"
    },
    {
      "key": "carrier",
      "value": "tipsa"
    },
    {
      "key": "expedition_id",
      "value": "EXP001"
    },
    {
      "key": "order_id",
      "value": "MIR-001"
    },
    {
      "key": "webhook_secret",
      "value": "redacted-value"
    },
    {
      "key": "computed_signature",
      "value": "redacted-value"
    }
  ],
  "globals": [],
  "variables": [],
  "cookies": [],
  "response": {
    "code": 200,
    "status": "OK",
    "header": [
      {
        "key": "Content-Type",
        "value": "application/json"
      }
    ],
    "body": "{\"id\":1,\"name\":\"example\",\"status\":\"active\",\"data\":[{\"id\":1,\"value\":\"a\"},{\"id\":2,\"value\":\"b\"}],\"token\":\"test-token\",\"access_token\":\"test-access-token\",\"success\":true,\"message\":\"ok\",\"total\":2}",
    "responseTime": 120
  }
}
