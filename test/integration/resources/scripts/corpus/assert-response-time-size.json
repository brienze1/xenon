{
  "id": "assert-response-time-size",
  "covers": [
    "sandbox-api §2 responseTime",
    "sandbox-api §2 responseSize"
  ],
  "source": {
    "kind": "hand-written",
    "licence": "Xenon project (same licence as this repository)"
  },
  "phase": "test",
  "script": "pm.test('responseTime below', () => pm.expect(pm.response.responseTime).to.be.below(200));\npm.test('responseTime chain', () => pm.response.to.have.responseTime.below(100));\npm.test('responseTime chain ok', () => pm.response.to.have.responseTime.above(100));\npm.test('responseSize', () => pm.response.to.have.responseSize.above(10));\npm.test('responseSize exact', () => pm.response.to.have.responseSize(5));",
  "request": {
    "url": "https://api.example.com/v1/users?page=2&limit=10",
    "method": "POST",
    "header": [
      {
        "key": "Content-Type",
        "value": "application/json"
      },
      {
        "key": "X-Trace",
        "value": "abc"
      }
    ],
    "body": {
      "mode": "raw",
      "raw": "{\"name\":\"Ada\",\"tags\":[\"a\",\"b\"]}"
    }
  },
  "environment": {
    "name": "dev",
    "values": [
      {
        "key": "base_url",
        "value": "https://api.example.com"
      },
      {
        "key": "user",
        "value": "ada"
      },
      {
        "key": "shared",
        "value": "from-env"
      }
    ]
  },
  "collectionVariables": [
    {
      "key": "version",
      "value": "v1"
    },
    {
      "key": "shared",
      "value": "from-collection"
    },
    {
      "key": "coll_only",
      "value": "c"
    }
  ],
  "globals": [
    {
      "key": "tenant",
      "value": "acme"
    },
    {
      "key": "shared",
      "value": "from-globals"
    },
    {
      "key": "glob_only",
      "value": "g"
    }
  ],
  "variables": [
    {
      "key": "local_only",
      "value": "l"
    }
  ],
  "cookies": [
    {
      "name": "session",
      "value": "s1",
