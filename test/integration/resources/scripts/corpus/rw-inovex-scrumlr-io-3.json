{
  "id": "rw-inovex-scrumlr-io-3",
  "covers": [
    "real-world",
    "real-world oauth-token-chain"
  ],
  "source": {
    "kind": "public-collection",
    "repository": "https://github.com/inovex/scrumlr.io",
    "path": "server/api.postman_collection.json",
    "url": "https://github.com/inovex/scrumlr.io/blob/6bae213129563eea946ec58e7a38d068dc53e0c3/server/api.postman_collection.json",
    "licence": "MIT",
    "item": "Delete board"
  },
  "phase": "prerequest",
  "script": "let body = {\n    \"name\": \"Board to delete\",\n    \"accessPolicy\": \"PUBLIC\",\n    \"columns\": [\n        {\n            \"name\": \"Lean coffee\",\n            \"visible\": true,\n            \"color\": \"backlog-blue\"\n        },\n        {\n            \"name\": \"Actions\",\n            \"visible\": false,\n            \"color\": \"planning-pink\"\n        }\n    ]\n}\nbody = JSON.stringify(body)\n\npm.sendRequest({\n    url: pm.variables.get(\"base_url\") + \"/boards\",\n    method: 'POST',\n    header: {\n        \"Content-Type\": \"application/json; charset=utf-8\",\n        \"Authorization\": pm.collectionVariables.get(\"jwt\"),\n    },\n    body: body,\n\n}, function (err, response) {\n    pm.test(\"PreRequestScript – Successful POST request (createBoard)\", () => {\n        pm.expect(response.code).to.be.equal(201);\n    });\n    \n    const res = response.json();\n    pm.test(\"PreRequestScript – Check id is included\", () => {\n        const id = res.id;\n        pm.expect(id).to.exist;\n        pm.collectionVariables.set(\"board_to_delete_id\", res.id); \n    })\n\n    pm.test(\"PreRequestScript – Check name is included\", () => {\n        const boardName = res.name;\n        pm.expect(boardName).to.exist;\n    })\n});",
  "request": {
    "url": "{{base_url}}/boards/{{board_to_delete_id}}",
    "method": "DELETE",
    "header": []
  },
  "environment": {
    "name": "real-world",
    "values": []
  },
  "collectionVariables": [
    {
