{
  "id": "assert-postman-types",
  "covers": [
    "sandbox-api §2 postmanRequest",
    "sandbox-api §2 postmanResponse",
    "sandbox-api §2 postmanRequestOrResponse"
  ],
  "source": {
    "kind": "hand-written",
    "licence": "Xenon project (same licence as this repository)"
  },
  "phase": "test",
  "script": "pm.test('response is postmanResponse', () => pm.response.to.be.postmanResponse);\npm.test('response is not postmanRequest', () => pm.response.to.be.postmanRequest);\npm.test('response is request or response', () => pm.response.to.be.postmanRequestOrResponse);\npm.test('request is postmanRequest', () => pm.request.to.be.postmanRequest);\npm.test('object is postmanResponse', () => pm.expect({}).to.be.postmanResponse);",
  "request": {
