    "sandbox-api §1 pm.request"
  ],
  "source": {
    "kind": "hand-written",
    "licence": "Xenon project (same licence as this repository)"
  },
  "phase": "prerequest",
  "script": "console.log(pm.request.auth.type, pm.request.auth.parameters().get('token'));",
  "request": {
    "url": "https://api.example.com/x",
    "method": "GET",
    "header": [],
