{
  "id": "pm-request-method-auth-clone",
  "covers": [
    "sandbox-api §1 pm.request"
  ],
  "source": {
    "kind": "hand-written",
    "licence": "Xenon project (same licence as this repository)"
  },
  "phase": "prerequest",
  "script": "pm.request.method = 'PUT';\nconst copy = pm.request.clone();\ncopy.headers.add({key: 'Only-Copy', value: '1'});\nconsole.log(pm.request.method, pm.request.headers.has('Only-Copy'), copy.headers.has('Only-Copy'));\nconsole.log(pm.request.auth === undefined ? 'no-auth' : pm.request.auth.type);\nconsole.log(typeof pm.request.size(), Object.keys(pm.request.toJSON()).sort());",
  "request": {
    "url": "https://api.example.com/v1/users?page=2&limit=10",
    "method": "POST",
    "header": [
      {
        "key": "Content-Type",
        "value": "application/json"
      },
      {
        "key": "X-Trace",
        "value": "abc"
      }
    ],
    "body": {
      "mode": "raw",
      "raw": "{\"name\":\"Ada\",\"tags\":[\"a\",\"b\"]}"
    }
  },
  "environment": {
    "name": "dev",
    "values": [
