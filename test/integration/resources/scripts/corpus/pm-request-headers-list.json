{
  "id": "pm-request-headers-list",
  "covers": [
    "sandbox-api §1 pm.request.headers"
  ],
  "source": {
    "kind": "hand-written",
    "licence": "Xenon project (same licence as this repository)"
  },
  "phase": "prerequest",
  "script": "const h = pm.request.headers;\nconsole.log(h.count(), h.has('content-type'), h.has('X-Trace', 'abc'), h.get('x-trace'), h.one('X-Trace').value, h.all().length);\nconsole.log(h.idx(0).key, h.indexOf('X-Trace'), h.toObject());\nconst keys = [];\nh.each((header) => keys.push(header.key));\nconsole.log(keys, h.map((x) => x.value), h.filter((x) => x.key.startsWith('X')).length, h.find((x) => x.value === 'abc').key);\nconsole.log(h.reduce((acc, x) => acc + x.key.length, 0));",
  "request": {
    "url": "https://api.example.com/v1/users?page=2&limit=10",
    "method": "POST",
    "header": [
      {
        "key": "Content-Type",
        "value": "application/json"
      },
      {
        "key": "X-Trace",
        "value": "abc"
      }
    ],
    "body": {
      "mode": "raw",
      "raw": "{\"name\":\"Ada\",\"tags\":[\"a\",\"b\"]}"
    }
  },
  "environment": {
    "name": "dev",
    "values": [
      {
        "key": "base_url",
        "value": "https://api.example.com"
      },
      {
        "key": "user",
        "value": "ada"
      },
      {
        "key": "shared",
        "value": "from-env"
      }
    ]
  },
  "collectionVariables": [
    {
      "key": "version",
      "value": "v1"
    },
    {
      "key": "shared",
      "value": "from-collection"
    },
    {
      "key": "coll_only",
      "value": "c"
    }
  ],
  "globals": [
    {
      "key": "tenant",
      "value": "acme"
    },
    {
      "key": "shared",
      "value": "from-globals"
    },
    {
      "key": "glob_only",
      "value": "g"
    }
  ],
  "variables": [
    {
      "key": "local_only",
      "value": "l"
    }
  ],
  "cookies": [
    {
      "name": "session",
      "value": "s1",
      "domain": "api.example.com",
      "path": "/"
    },
    {
      "name": "theme",
      "value": "dark",
      "domain": "api.example.com",
      "path": "/"
    }
  ]
}
