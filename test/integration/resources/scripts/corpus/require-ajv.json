  "phase": "prerequest",
  "script": "const Ajv = require('ajv'); const ajv = new Ajv({allErrors: true}); const validate = ajv.compile({type: 'object', required: ['id'], properties: {id: {type: 'number'}}}); console.log(validate({id: 1}), validate({id: 'x'}), validate.errors.map((e) => e.dataPath + ' ' + e.message));",
  "request": {
    "url": "https://api.example.com/v1/users?page=2&limit=10",
    "method": "POST",
    "header": [
      {
        "key": "Content-Type",
        "value": "application/json"
      },
      {
        "key": "X-Trace",
        "value": "abc"
      }
    ],
    "body": {
      "mode": "raw",
      "raw": "{\"name\":\"Ada\",\"tags\":[\"a\",\"b\"]}"
    }
  },
