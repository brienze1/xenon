{
  "id": "pm-send-request-callback",
  "covers": [
    "sandbox-api §1 pm.sendRequest"
  ],
  "source": {
    "kind": "hand-written",
    "licence": "Xenon project (same licence as this repository)"
  },
  "phase": "prerequest",
  "script": "pm.sendRequest('https://auth.example.com/token', (err, res) => {\n  console.log(err, res.code, res.json().access_token);\n  pm.environment.set('token', res.json().access_token);\n});",
  "request": {
    "url": "https://api.example.com/v1/users?page=2&limit=10",
    "method": "POST",
    "header": [
      {
        "key": "Content-Type",
        "value": "application/json"
      },
      {
        "key": "X-Trace",
        "value": "abc"
      }
    ],
    "body": {
      "mode": "raw",
      "raw": "{\"name\":\"Ada\",\"tags\":[\"a\",\"b\"]}"
    }
  },
  "environment": {
    "name": "dev",
    "values": [
      {
        "key": "base_url",
        "value": "https://api.example.com"
      },
      {
        "key": "user",
        "value": "ada"
      },
      {
        "key": "shared",
        "value": "from-env"
      }
    ]
  },
  "collectionVariables": [
    {
      "key": "version",
      "value": "v1"
    },
    {
      "key": "shared",
      "value": "from-collection"
    },
    {
      "key": "coll_only",
      "value": "c"
    }
  ],
  "globals": [
    {
      "key": "tenant",
      "value": "acme"
    },
    {
      "key": "shared",
      "value": "from-globals"
    },
    {
      "key": "glob_only",
      "value": "g"
    }
  ],
  "variables": [
    {
      "key": "local_only",
      "value": "l"
    }
  ],
  "cookies": [
    {
      "name": "session",
      "value": "s1",
      "domain": "api.example.com",
      "path": "/"
    },
    {
      "name": "theme",
      "value": "dark",
      "domain": "api.example.com",
      "path": "/"
    }
  ],
  "sendRequest": [
    {
      "code": 200,
      "status": "OK",
      "header": [
        {
          "key": "Content-Type",
          "value": "application/json"
        }
      ],
      "body": "{\"access_token\":\"tok-abc\",\"expires_in\":3600}"
    }
  ]
}
