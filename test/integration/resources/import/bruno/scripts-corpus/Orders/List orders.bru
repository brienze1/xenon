meta {
  name: List orders
  type: http
  seq: 1
}

get {
  url: {{base_url}}/orders?page={{page}}
  body: none
  auth: inherit
}

script:post-response {
  const page = Number(bru.getVar("page") || 1);
  const body = res.getBody();
  if (body.next) {
    bru.setVar("page", page + 1);
    bru.setNextRequest("List orders");
  } else {
    bru.setVar("page", 1);
  }
}

tests {
  test("lists orders", function () {
    expect(res.getStatus()).to.equal(200);
    expect(res.getBody().items).to.be.an("array");
    expect(res.getHeader("content-type")).to.include("application/json");
  });
}
