  {
    "id": "send-request",
    "title": "Send a request",
    "phase": "any",
    "text": "pm.sendRequest(\"https://postman-echo.com/get\", function (err, response) {\n    console.log(response.json());\n});"
  },
  {
    "id": "status-code-200",
    "title": "Status code: Code is 200",
    "phase": "postResponse",
    "text": "pm.test(\"Status code is 200\", function () {\n    pm.response.to.have.status(200);\n});"
  },
  {
    "id": "body-contains-string",
    "title": "Response body: Contains string",
    "phase": "postResponse",
    "text": "pm.test(\"Body matches string\", function () {\n    pm.expect(pm.response.text()).to.include(\"string_you_want_to_search\");\n});"
  },
  {
    "id": "json-value-check",
    "title": "Response body: JSON value check",
    "phase": "postResponse",
    "text": "pm.test(\"Your test name\", function () {\n    var jsonData = pm.response.json();\n    pm.expect(jsonData.value).to.eql(100);\n});"
  },
  {
    "id": "body-equals-string",
    "title": "Response body: Is equal to a string",
    "phase": "postResponse",
    "text": "pm.test(\"Body is correct\", function () {\n    pm.response.to.have.body(\"response_body_string\");\n});"
  },
  {
    "id": "content-type-header",
    "title": "Response headers: Content-Type header check",
    "phase": "postResponse",
    "text": "pm.test(\"Content-Type is present\", function () {\n    pm.response.to.have.header(\"Content-Type\");\n});"
  },
  {
    "id": "response-time",
    "title": "Response time is less than 200ms",
    "phase": "postResponse",
    "text": "pm.test(\"Response time is less than 200ms\", function () {\n    pm.expect(pm.response.responseTime).to.be.below(200);\n});"
  },
  {
    "id": "successful-post",
    "title": "Status code: Successful POST request",
    "phase": "postResponse",
    "text": "pm.test(\"Successful POST request\", function () {\n    pm.expect(pm.response.code).to.be.oneOf([201, 202]);\n});"
  },
  {
    "id": "status-code-name",
